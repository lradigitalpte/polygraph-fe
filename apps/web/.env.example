# =============================================================================
# Local development — copy to apps/web/.env.local and fill in real values
# =============================================================================

# Go API (Railway backend) — no trailing slash
NEXT_PUBLIC_API_URL=http://localhost:8080

# Better Auth / Neon Auth base URL (browser must reach this)
NEXT_PUBLIC_NEON_AUTH_URL=http://localhost:8080/api/auth

# Marketing page health check (usually same as API URL)
NEXT_PUBLIC_SERVER_URL=http://localhost:8080

# =============================================================================
# Vercel production — https://polygraph-fe-web.vercel.app
# Set these in: Vercel → polygraph-fe-web → Settings → Environment Variables
# Apply to: Production (and Preview if you want PR deploys to work)
# =============================================================================

# NEXT_PUBLIC_API_URL=https://YOUR-RAILWAY-SERVICE.up.railway.app
# NEXT_PUBLIC_NEON_AUTH_URL=https://YOUR-NEON-AUTH-HOST/api/auth
# NEXT_PUBLIC_SERVER_URL=https://YOUR-RAILWAY-SERVICE.up.railway.app

# =============================================================================
# Railway backend (polygraph-be) — set on the API service, not Vercel
# =============================================================================

# FRONTEND_URL=https://polygraph-fe-web.vercel.app
# APP_PUBLIC_URL=https://polygraph-fe-web.vercel.app
# CORS_ORIGINS=https://polygraph-fe-web.vercel.app,https://polygraph-fe-web-*.vercel.app
